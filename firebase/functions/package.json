{
  "name": "wyd-chicago-functions",
  "description": "Cloud Functions for WYD Chicago — counters, profile bootstrap, role management.",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions,firestore,auth",
